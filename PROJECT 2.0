          "text": [
            "Enter marks: 34\n",
            "Grade: F\n"
          ]
        }
      ],
      "source": [
        "def calculate_grade(marks):\n",
        "    if marks >= 90:\n",
        "        return \"A+\"\n",
        "    elif marks >= 80:\n",
        "        return \"A\"\n",
        "    elif marks >= 70:\n",
        "        return \"B\"\n",
        "    elif marks >= 60:\n",
        "        return \"C\"\n",
        "    elif marks >= 50:\n",
        "        return \"D\"\n",
        "    else:\n",
        "        return \"F\"\n",
        "\n",
        "\n",
        "marks = float(input(\"Enter marks: \"))\n",
        "\n",
        "if 0 <= marks <= 100:\n",
        "    grade = calculate_grade(marks)\n",
        "    print(f\"Grade: {grade}\")\n",
        "else:\n",
        "    print(\"Please enter marks between 0 and 100.\")\n"
      ]
    }
  ]
}